#!/usr/bin/env bash
# Calls every operation against the seeded app and prints each status code.
# It lends a book it adds itself and then deletes it, so it can run again and leaves the seeded books alone.
#
#   bin/smoke
#   BASE_URL=http://localhost:3000 bin/smoke
set -u

BASE_URL="${BASE_URL:-http://localhost:3000}"
failures=0

check() {
  local expected="$1" method="$2" path="$3" body="${4:-}"
  local args=(-s -o /dev/null -w "%{http_code}" -X "$method")

  if [ -n "$body" ]; then
    args+=(-H "Content-Type: application/json" -d "$body")
  fi

  local actual
  actual="$(curl "${args[@]}" "$BASE_URL$path")"

  if [ "$actual" = "$expected" ]; then
    echo "ok    $actual  $method $path"
  else
    echo "FAIL  $actual  $method $path (expected $expected)"
    failures=$((failures + 1))
  fi
}

check 200 GET "/api/v1/books"
check 201 POST "/api/v1/books" '{"serial_number":"004219","title":"The Pragmatic Programmer","authors":["Andrew Hunt","David Thomas"]}'
check 200 GET "/api/v1/books/000101"
check 200 PATCH "/api/v1/books/004219/status" '{"status":"borrowed","card_number":"100001"}'
check 200 PATCH "/api/v1/books/004219/status" '{"status":"available"}'
check 204 DELETE "/api/v1/books/004219"
check 409 DELETE "/api/v1/books/000102"
check 200 GET "/api/v1/readers/100001"
check 404 GET "/api/v1/readers/999999"
check 200 GET "/api/v1/readers/100001/books"
check 200 GET "/api/v1/readers/100002/books?include_returned=true"
check 404 GET "/api/v1/readers/999999/books"
check 201 POST "/api/v1/readers" '{"card_number":"100099","full_name":"Smoke Test","email":"smoke.test@example.com"}'
check 200 PATCH "/api/v1/readers/100099" '{"full_name":"Smoke Test Renamed"}'
check 204 DELETE "/api/v1/readers/100099"
check 409 DELETE "/api/v1/readers/100001"

if [ "$failures" -gt 0 ]; then
  echo "$failures failed"
  exit 1
fi

echo "All passed"
